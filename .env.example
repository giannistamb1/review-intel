# Copy to .env and fill in. .env is git-ignored. Shell variables override this file.

# Required. A treg team API key (treg.to team dashboard). Pays for Google Maps search, reviews, Local Finder.
TREG_API_KEY=

# Recommended. Anthropic API key for the 4-5 word complaint summaries (model below).
# Leave empty to use the signed-in `claude` CLI instead; with neither, review bullets stay blank.
ANTHROPIC_API_KEY=

# Hard spend cap per run in USD (treg + LLM together). The run stops calling paid APIs at the cap.
REVIEW_INTEL_MAX_USD=2

# Optional
# TREG_ORG=                          # only for a personal sign-in token; a team API key carries its team
# REVIEW_INTEL_MODEL=claude-haiku-5-5
# REVIEW_INTEL_WORKERS=8             # rows processed in parallel
# REVIEW_INTEL_RADIUS_MI=5           # competitor radius
# REVIEW_INTEL_MIN_COMPETITOR_REVIEWS=10
# REVIEW_INTEL_PORT=8765
# REVIEW_INTEL_LLM_IN_PER_MTOK=0.10  # $ per million tokens, for the spend meter only
# REVIEW_INTEL_LLM_OUT_PER_MTOK=0.50
